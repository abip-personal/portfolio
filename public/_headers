# Cloudflare Pages headers. Copied verbatim to dist/_headers at build time.
# Syntax: https://developers.cloudflare.com/pages/configuration/headers/

/*
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), camera=(), geolocation=(), gyroscope=(), microphone=(), payment=(), usb=()
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Resource-Policy: same-origin
  # Scoped deliberately: the canonical host is portfolio.abip.pt, a subdomain of
  # abip.pt, which is a private zone hosting a self-hosted/home-automation stack
  # — not a standalone apex we own end to end. Both optional directives were
  # dropped on purpose rather than inherited from the old diogoferreira.dev line.
  #   includeSubDomains — from this host it binds only *.portfolio.abip.pt. No
  #     such hosts exist and none are planned, so it is cost without benefit: it
  #     would pre-commit a namespace we never use while protecting nothing.
  #   preload — the HSTS preload list only accepts the registrable domain, so an
  #     entry for portfolio.abip.pt cannot be submitted and the directive is
  #     inert from here. Worse, it advertises an intent we have not formed:
  #     acting on it means submitting abip.pt itself, which binds *every* host in
  #     that zone to HTTPS-only, including internal services still on plain HTTP.
  #     That is a one-way door — slow and painful to unwind — and must be a
  #     separate, deliberate decision taken only once every abip.pt host is
  #     confirmed HTTPS-capable. Nothing has been submitted.
  # The max-age is unchanged (2 years) and still pins this host to HTTPS.
  Strict-Transport-Security: max-age=63072000
  # Trade-off: 'unsafe-inline' is required in both script-src and style-src.
  #   script-src — BaseLayout.astro runs an `is:inline` theme script in <head>
  #     before first paint. A hash would work, but Astro does not emit CSP hashes
  #     for `is:inline` blocks, so the hash would have to be maintained by hand
  #     and would silently break the no-flash behaviour whenever that script is
  #     edited. Revisit if Astro's experimental CSP support is enabled.
  #   style-src  — `build.inlineStylesheets: 'auto'` inlines small stylesheets,
  #     and Astro emits per-component <style> blocks.
  # One deliberate loosening beyond those two, and the only one touching
  # script-src: the single third-party origin
  # https://static.cloudflareinsights.com, which serves the Cloudflare Web
  # Analytics beacon (beacon.min.js). We do NOT tag it into our own markup
  # anywhere — Cloudflare injects the beacon at the edge, which is exactly why
  # it reaches the browser even though no <script> for it lives in
  # BaseLayout.astro. (Manually embedding the tag is the second documented
  # approach; it is out of scope here, and doing so now would risk loading the
  # beacon twice.) connect-src is deliberately NOT widened. Cloudflare
  # documents two reporting paths: an edge-injected beacon posts to
  # /cdn-cgi/rum on our own origin, which the 'self' here already covers, while
  # only a manually-embedded one posts to cloudflareinsights.com. Which applies
  # here is not settled — /cdn-cgi/rum currently 404s on this host — so adding a
  # third-party origin now would loosen the policy for a path never observed.
  # It stays out until a real connect-src violation is seen. To remove
  # this origin again, turn Cloudflare Web Analytics off in the dashboard —
  # that stops the edge from injecting the beacon at all. Everything else is
  # still locked down: no other third-party origins, no framing, no plugins,
  # no <base> hijacking. There is no user input and no server runtime, so the
  # residual XSS surface is effectively nil.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; manifest-src 'self'; media-src 'self'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; object-src 'none'; upgrade-insecure-requests

# Astro emits content-hashed filenames here, so they can be cached forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Build-time OG cards are stable per deploy but keep their own path, so give
# them a long browser TTL with revalidation at the edge.
#
# Worker Static Assets _headers rules ACCUMULATE rather than override:
#   "An incoming request which matches multiple rules URL patterns will
#    inherit all rules headers" — Cloudflare docs.
#
# The `/*` block above sets Cross-Origin-Resource-Policy: same-origin.  A bare
# re-declaration of `cross-origin` here does NOT replace it; both values are
# joined and sent, so a preview client reading the first header sees
# same-origin and refuses the card.  This exact dual-header bug was confirmed
# live on portfolio.abip.pt (POR-41).
#
# The `!` prefix unsets the inherited header first, leaving exactly one
# Cross-Origin-Resource-Policy: cross-origin on the response — the relaxation
# social and preview clients need.
/og/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

/og-default.png
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
  ! Cross-Origin-Resource-Policy
  Cross-Origin-Resource-Policy: cross-origin

# HTML and feeds must revalidate so a new deploy is picked up immediately.
/
  Cache-Control: public, max-age=0, must-revalidate

/*.html
  Cache-Control: public, max-age=0, must-revalidate

/rss.xml
  Cache-Control: public, max-age=3600

/sitemap-index.xml
  Cache-Control: public, max-age=3600
