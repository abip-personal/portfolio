---
/**
 * /work/ index — a thin route around <EntryIndex>: the category copy from
 * categories.ts, EntryCard grids, and the closing CTA all live there.
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import EntryIndex from '@/components/EntryIndex.astro';
---

<BaseLayout
  title="Work"
  description="Case studies and selected work: payment infrastructure, a multi-service agritech platform, AI-assisted engineering adoption, and certified regulated gaming."
>
  <SiteHeader slot="header" />
  <SiteFooter slot="footer" />

  <EntryIndex category="work" />
</BaseLayout>
