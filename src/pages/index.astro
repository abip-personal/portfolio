---
import BaseLayout from '@/layouts/BaseLayout.astro';
import SiteHeader from '@/components/SiteHeader.astro';
import SiteFooter from '@/components/SiteFooter.astro';
import Hero from '@/components/home/Hero.astro';
import Metrics from '@/components/home/Metrics.astro';
import FeaturedWork from '@/components/home/FeaturedWork.astro';
import Capabilities from '@/components/home/Capabilities.astro';
import AiShowcase from '@/components/home/AiShowcase.astro';
import Experience from '@/components/home/Experience.astro';
import OffTheClock from '@/components/home/OffTheClock.astro';
import Contact from '@/components/home/Contact.astro';
---

<BaseLayout>
  <SiteHeader slot="header" />

  <Hero />
  <Metrics />
  <FeaturedWork />
  <Capabilities />
  <AiShowcase />
  <Experience />
  <OffTheClock />
  <Contact />

  <SiteFooter slot="footer" />
</BaseLayout>
