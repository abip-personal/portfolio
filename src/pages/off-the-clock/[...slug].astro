---
/**
 * One page per published off-the-clock entry, at /off-the-clock/<id>/.
 *
 * Category-scoped: getStaticPaths only sees 'off-the-clock' entries, so
 * prev/next never crosses into work. No diagram map — the MDX bodies render
 * as-is through EntryLayout.
 */
import type { GetStaticPaths } from 'astro';
import { getCollection, render, type CollectionEntry } from 'astro:content';
import EntryLayout from '@/layouts/EntryLayout.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const entries = (await getCollection('entries', ({ data }) => !data.draft))
    .filter((entry) => entry.data.category === 'off-the-clock')
    .sort((a, b) => a.data.order - b.data.order);

  return entries.map((entry, index) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: index > 0 ? entries[index - 1] : undefined,
      next: index < entries.length - 1 ? entries[index + 1] : undefined,
    },
  }));
};

interface Props {
  entry: CollectionEntry<'entries'>;
  prev?: CollectionEntry<'entries'>;
  next?: CollectionEntry<'entries'>;
}

const { entry, prev, next } = Astro.props;
const { Content } = await render(entry);
---

<EntryLayout entry={entry} prev={prev} next={next}>
  <Content />
</EntryLayout>
