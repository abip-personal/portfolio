---
/**
 * Shipped feature: the site ships three complete visual identities
 * (Blueprint/Signal, Archive, Console), and this control switches between
 * them. The style axis is orthogonal to the light/dark theme axis; both are
 * stamped before first paint (see BaseLayout.astro) so neither flashes.
 *
 * Hidden below the `sm` breakpoint: the header control row cannot fit it at
 * 360px without causing horizontal overflow, and the chosen style persists in
 * localStorage, so picking one at desktop width carries over to a narrow
 * viewport.
 *
 * Cycles the `data-style` axis so the identities can be experienced against
 * real pages rather than swatches; the choice persists in localStorage and is
 * resolved again before first paint by BaseLayout.astro.
 */
const STYLES = [
  { id: 'signal', label: 'Blueprint / Signal' },
  { id: 'archive', label: 'Archive' },
  { id: 'console', label: 'Console' },
] as const;
---

<div class="style-switcher hidden sm:block">
  <label class="sr-only" for="style-select">Visual style (preview)</label>
  <select id="style-select" class="style-switcher__select">
    {STYLES.map((s) => <option value={s.id}>{s.label}</option>)}
  </select>
</div>

<style>
  .style-switcher__select {
    appearance: none;
    background: var(--surface-raised);
    color: var(--ink-muted);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm, 0.375rem);
    font: inherit;
    font-size: 0.75rem;
    padding: 0.35rem 0.5rem;
    max-width: 10rem;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

<script>
  const select = document.getElementById('style-select') as HTMLSelectElement | null;
  if (select) {
    const current = document.documentElement.dataset.style ?? 'signal';
    select.value = current;
    select.addEventListener('change', () => {
      document.documentElement.dataset.style = select.value;
      try {
        localStorage.setItem('style', select.value);
      } catch {
        /* Non-fatal: the choice just will not persist. */
      }
    });
  }
</script>
