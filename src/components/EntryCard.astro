---
/**
 * One card for any `entries` item, both categories and both treatments.
 *
 * The look is picked by entry.data.treatment, shared across work and
 * off-the-clock: 'deep-dive' carries a `Case study` badge, 'summary' a
 * `Summary` badge. `emphasis` picks the sizing — 'feature' is the larger
 * home-page treatment (deep-dive: bigger card, 3xl title, first metric
 * inline; summary: first metric inline), while 'default' is the index-page
 * sizing (full metrics list, or the compact card for summaries). When an
 * entry has no org/period/metrics/stack (off-the-clock), the credit line is
 * suppressed, the glyph and tags stand in, and no empty lists ever render.
 */
import type { CollectionEntry } from 'astro:content';
import { categories, entryHref } from '@/lib/categories';
import Badge from '@/components/ui/Badge.astro';
import Card from '@/components/ui/Card.astro';
import TagList from '@/components/TagList.astro';
import EntryCardBadges from '@/components/EntryCardBadges.astro';

interface Props {
  entry: CollectionEntry<'entries'>;
  /** 'feature' is the larger home-page sizing; 'default' the index-page sizing. */
  emphasis?: 'feature' | 'default';
  /** Hide the category badge (index pages are already inside one category). */
  showCategory?: boolean;
  class?: string;
}

const { entry, emphasis = 'default', showCategory = true, class: className } = Astro.props;
const { title, blurb, glyph, org, period, metrics, stack, tags, category: slug, treatment } =
  entry.data;

const category = categories[slug];
const isDeepDive = treatment === 'deep-dive';
const isFeature = emphasis === 'feature';
const hasCredit = Boolean(org || period);
const creditLine = [org, period].filter(Boolean).join(' · ');
const cta = isDeepDive
  ? 'Read the case study →'
  : isFeature
    ? 'Read more →'
    : 'Read the write-up →';
---

{
  isDeepDive && isFeature ? (
    <Card
      href={entryHref(entry)}
      variant="feature"
      padding="lg"
      class:list={['flex h-full flex-col', className]}
    >
      <EntryCardBadges
        treatment={treatment}
        categoryLabel={category.label}
        showCategory={showCategory}
        glyph={glyph}
        creditLine={creditLine}
        emphasis={emphasis}
      />
      {!hasCredit && <TagList tags={tags} linked={false} class="mt-4" />}
      <h3 class="mt-4 text-3xl font-extrabold text-balance text-ink group-hover:text-accent">
        {title}
      </h3>
      <p class="mt-3 text-pretty text-ink-muted">{blurb}</p>

      {metrics[0] && (
        <p class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-1">
          <span class="text-stat-sm text-gradient font-extrabold tabular-nums">
            {metrics[0].value}
          </span>
          <span class="text-sm font-semibold tracking-wide text-ink uppercase">
            {metrics[0].label}
          </span>
        </p>
      )}

      {stack.length > 0 && (
        <ul class="mt-6 flex flex-wrap gap-2" aria-label="Stack">
          {stack.slice(0, 5).map((item) => (
            <li>
              <Badge variant="outline">{item}</Badge>
            </li>
          ))}
        </ul>
      )}

      <p class="mt-6 text-sm font-semibold text-accent">{cta}</p>
    </Card>
  ) : (
    isDeepDive && !isFeature ? (
      <Card
        href={entryHref(entry)}
        variant="raised"
        padding="lg"
        class:list={['h-full', className]}
      >
        <EntryCardBadges
        treatment={treatment}
        categoryLabel={category.label}
        showCategory={showCategory}
        glyph={glyph}
        creditLine={creditLine}
        emphasis={emphasis}
      />
        {!hasCredit && <TagList tags={tags} linked={false} class="mt-4" />}
        <h3 class="mt-4 text-2xl font-extrabold text-balance text-ink group-hover:text-accent">
          {title}
        </h3>
        <p class="mt-3 text-pretty text-ink-muted">{blurb}</p>

        {metrics.length > 0 && (
          <dl class="mt-6 flex flex-wrap gap-x-8 gap-y-4" aria-label="Metrics">
            {metrics.map((metric) => (
              <div class="flex flex-col-reverse">
                <dt class="mt-1 text-xs font-semibold tracking-wide text-ink uppercase">
                  {metric.label}
                </dt>
                <dd class="text-stat-sm font-extrabold tabular-nums text-gradient">
                  {metric.value}
                </dd>
              </div>
            ))}
          </dl>
        )}

        {stack.length > 0 && (
          <ul class="mt-6 flex flex-wrap gap-2" aria-label="Stack">
            {stack.slice(0, 6).map((item) => (
              <li>
                <Badge variant="neutral">{item}</Badge>
              </li>
            ))}
          </ul>
        )}

        <p class="mt-6 text-sm font-semibold text-accent">{cta}</p>
      </Card>
    ) : (
      isFeature ? (
        <Card
          href={entryHref(entry)}
          variant="raised"
          padding="lg"
          class:list={['h-full', className]}
        >
          <EntryCardBadges
        treatment={treatment}
        categoryLabel={category.label}
        showCategory={showCategory}
        glyph={glyph}
        creditLine={creditLine}
        emphasis={emphasis}
      />
          {!hasCredit && <TagList tags={tags} linked={false} class="mt-4" />}
          <h3 class="mt-3 text-xl font-bold text-balance text-ink group-hover:text-accent">
            {title}
          </h3>
          <p class="mt-2 text-sm text-pretty text-ink-muted">{blurb}</p>

          {metrics[0] && (
            <p class="mt-4 flex flex-wrap items-baseline gap-x-2">
              <span class="text-gradient text-xl font-extrabold tabular-nums">
                {metrics[0].value}
              </span>
              <span class="text-xs font-semibold tracking-wide text-ink uppercase">
                {metrics[0].label}
              </span>
            </p>
          )}

          {stack.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2" aria-label="Stack">
              {stack.slice(0, 4).map((item) => (
                <li>
                  <Badge variant="outline">{item}</Badge>
                </li>
              ))}
            </ul>
          )}

          <p class="mt-4 text-sm font-semibold text-accent">{cta}</p>
        </Card>
      ) : (
        <Card href={entryHref(entry)} padding="md" class:list={['h-full', className]}>
          <EntryCardBadges
        treatment={treatment}
        categoryLabel={category.label}
        showCategory={showCategory}
        glyph={glyph}
        creditLine={creditLine}
        emphasis={emphasis}
      />
          {!hasCredit && <TagList tags={tags} linked={false} class="mt-3" />}
          <h3 class="mt-3 text-lg font-bold text-pretty text-ink group-hover:text-accent">
            {title}
          </h3>
          <p class="mt-2 text-sm text-pretty text-ink-muted">{blurb}</p>
        </Card>
      )
    )
  )
}
