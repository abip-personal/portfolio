---
/**
 * Off the clock. A deliberate change of texture after the timeline: warmer,
 * softer, two cards side by side. Bodies are still being written, so a card
 * that renders near-empty simply stands on its blurb.
 */
import { getCollection, render } from 'astro:content';
import Container from '@/components/ui/Container.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import Prose from '@/components/ui/Prose.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';

const entries = (await getCollection('hobbies')).sort((a, b) => a.data.order - b.data.order);

const rendered = await Promise.all(
  entries.map(async (entry) => ({ entry, Content: (await render(entry)).Content }))
);
---

<section class="border-y border-border-subtle bg-surface-raised">
  <Container size="wide" class="py-16 sm:py-24">
    <SectionHeading
      id="hobbies"
      eyebrow="Off the clock"
      title="Still building, just for me"
      description="The projects nobody asked for — the ones where I own every layer, including the enclosure."
    />

    <div class="mt-10 grid gap-5 lg:grid-cols-2">
      {
        rendered.map(({ entry, Content }) => (
          <Card variant="default" padding="lg" as="article" class="h-full">
            {entry.data.glyph && (
              <p aria-hidden="true" class="text-3xl leading-none">
                {entry.data.glyph}
              </p>
            )}
            <h3 class="mt-4 text-2xl font-bold text-balance text-ink">{entry.data.title}</h3>
            <p class="mt-3 text-lg text-pretty text-ink-muted">{entry.data.blurb}</p>

            <Prose class="mt-5 max-w-none text-base">
              <Content />
            </Prose>

            {entry.data.tags.length > 0 && (
              <ul class="mt-6 flex flex-wrap gap-2">
                {entry.data.tags.map((tag) => (
                  <li>
                    <Badge variant="signal">{tag}</Badge>
                  </li>
                ))}
              </ul>
            )}
          </Card>
        ))
      }
    </div>
  </Container>
</section>
