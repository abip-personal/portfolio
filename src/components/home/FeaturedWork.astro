---
/**
 * Selected work. The two deep-dive case studies take the full-width, larger
 * treatment; the two summaries sit underneath at half the visual weight.
 */
import { getCollection } from 'astro:content';
import Container from '@/components/ui/Container.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order
);

const deepDives = projects.filter((p) => p.data.treatment === 'deep-dive');
const summaries = projects.filter((p) => p.data.treatment !== 'deep-dive');
---

<section class="scroll-mt-24">
  <Container size="wide" class="py-16 sm:py-24">
    <SectionHeading
      id="work"
      eyebrow="Selected work"
      title="Systems that had to hold"
      description="Four pieces of work, written up honestly: what the constraint was, what I changed, and what it measurably did."
    />

    <ul class="mt-10 grid gap-5 lg:grid-cols-2">
      {
        deepDives.map((project) => (
          <li>
            <Card
              href={`/work/${project.id}/`}
              variant="feature"
              padding="lg"
              class="flex h-full flex-col"
            >
              <div class="flex flex-wrap items-center gap-2">
                <Badge variant="accent">Case study</Badge>
                <span class="text-xs font-semibold tracking-wide text-ink-subtle uppercase">
                  {project.data.org} · {project.data.period}
                </span>
              </div>

              <h3 class="mt-4 text-3xl font-extrabold text-balance text-ink">
                {project.data.title}
              </h3>
              <p class="mt-3 text-pretty text-ink-muted">{project.data.blurb}</p>

              {project.data.metrics[0] && (
                <p class="mt-6 flex flex-wrap items-baseline gap-x-3 gap-y-1">
                  <span class="text-stat-sm text-gradient font-extrabold tabular-nums">
                    {project.data.metrics[0].value}
                  </span>
                  <span class="text-sm font-semibold tracking-wide text-ink uppercase">
                    {project.data.metrics[0].label}
                  </span>
                </p>
              )}

              <ul class="mt-6 flex flex-wrap gap-2">
                {project.data.stack.slice(0, 5).map((item) => (
                  <li>
                    <Badge variant="outline">{item}</Badge>
                  </li>
                ))}
              </ul>

              <p class="mt-6 text-sm font-semibold text-accent">Read the case study →</p>
            </Card>
          </li>
        ))
      }
    </ul>

    <ul class="mt-5 grid gap-5 lg:grid-cols-2">
      {
        summaries.map((project) => (
          <li>
            <Card href={`/work/${project.id}/`} variant="raised" padding="lg" class="h-full">
              <div class="flex flex-wrap items-center gap-2">
                <Badge>Summary</Badge>
                <span class="text-xs font-semibold tracking-wide text-ink-subtle uppercase">
                  {project.data.org} · {project.data.period}
                </span>
              </div>

              <h3 class="mt-3 text-xl font-bold text-balance text-ink">{project.data.title}</h3>
              <p class="mt-2 text-sm text-pretty text-ink-muted">{project.data.blurb}</p>

              {project.data.metrics[0] && (
                <p class="mt-4 flex flex-wrap items-baseline gap-x-2">
                  <span class="text-gradient text-xl font-extrabold tabular-nums">
                    {project.data.metrics[0].value}
                  </span>
                  <span class="text-xs font-semibold tracking-wide text-ink uppercase">
                    {project.data.metrics[0].label}
                  </span>
                </p>
              )}

              <ul class="mt-4 flex flex-wrap gap-2">
                {project.data.stack.slice(0, 4).map((item) => (
                  <li>
                    <Badge variant="outline">{item}</Badge>
                  </li>
                ))}
              </ul>

              <p class="mt-4 text-sm font-semibold text-accent">Read more →</p>
            </Card>
          </li>
        ))
      }
    </ul>
  </Container>
</section>
