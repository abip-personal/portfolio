---
/**
 * Selected work. The two deep-dive case studies take the full-width, larger
 * EntryCard treatment (emphasis="feature"); the two summaries sit underneath
 * at half the visual weight. The badge vocabulary ('Case study' / 'Summary')
 * comes from each entry's treatment in EntryCard. All links derive from
 * entryHref in categories.ts.
 */
import { getCollection } from 'astro:content';
import Container from '@/components/ui/Container.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';
import EntryCard from '@/components/EntryCard.astro';

const entries = (await getCollection('entries', ({ data }) => !data.draft))
  .filter((entry) => entry.data.category === 'work')
  .sort((a, b) => a.data.order - b.data.order);

const deepDives = entries.filter((entry) => entry.data.treatment === 'deep-dive');
const summaries = entries.filter((entry) => entry.data.treatment !== 'deep-dive');
---

<section class="scroll-mt-24">
  <Container size="wide" class="py-16 sm:py-24">
    <SectionHeading
      id="work"
      eyebrow="Selected work"
      title="Systems that had to hold"
      description="Four pieces of work, written up honestly: what the constraint was, what I changed, and what it measurably did."
    />

    <ul class="mt-10 grid gap-5 lg:grid-cols-2">
      {
        deepDives.map((entry) => (
          <li>
            <EntryCard entry={entry} emphasis="feature" class="h-full" />
          </li>
        ))
      }
    </ul>

    <ul class="mt-5 grid gap-5 lg:grid-cols-2">
      {
        summaries.map((entry) => (
          <li>
            <EntryCard entry={entry} emphasis="feature" class="h-full" />
          </li>
        ))
      }
    </ul>
  </Container>
</section>
