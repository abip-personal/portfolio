---
/**
 * Core competencies, taken from the CV and grouped so the list is scannable
 * rather than a tag soup: each group gets a heading and a one-line framing,
 * then short atomic chips underneath.
 */
import Container from '@/components/ui/Container.astro';
import Card from '@/components/ui/Card.astro';
import Badge from '@/components/ui/Badge.astro';
import SectionHeading from '@/components/ui/SectionHeading.astro';

const groups: Array<{ title: string; summary: string; items: string[] }> = [
  {
    title: 'Languages, frameworks & data',
    summary: 'Full-stack TypeScript, with Java and Python alongside and relational and NoSQL stores behind it.',
    items: [
      'TypeScript',
      'Node.js',
      'NestJS',
      'React',
      'React Native',
      'Java',
      'Python',
      'PostgreSQL',
      'MySQL',
      'MongoDB',
      'Redis',
      'DynamoDB',
    ],
  },
  {
    title: 'AWS',
    summary: 'Compute, messaging, data and security services run in production, with the infrastructure owned as code.',
    items: [
      'EC2',
      'ECS / Fargate',
      'ECR',
      'Lambda',
      'API Gateway',
      'CloudFront',
      'S3',
      'RDS / Aurora',
      'SQS / SNS',
      'EventBridge',
      'Step Functions',
      'Athena',
      'Glue',
      'Secrets Manager',
      'IAM',
      'Cognito',
      'CloudWatch',
    ],
  },
  {
    title: 'AI & AI-assisted engineering',
    summary: 'LLMs integrated into products, and AI tooling adopted across a whole engineering team.',
    items: [
      'LLM integration',
      'Claude',
      'OpenAI',
      'Gemini',
      'Ollama (self-hosted models)',
      'GitHub Copilot',
      'Devin',
      'Atlassian Rovo',
      'Orca',
    ],
  },
  {
    title: 'DevOps & architecture',
    summary: 'A pipeline that ships several times a day, and systems designed to fail in understood ways.',
    items: [
      'Terraform',
      'Docker',
      'Kubernetes (basic)',
      'GitLab CI',
      'GitHub Actions',
      'System design',
      'Distributed systems',
      'Microservices',
      'Event-driven architecture',
      'REST',
      'GraphQL',
      'OpenAPI',
    ],
  },
  {
    title: 'Quality & operations',
    summary: 'Automated testing, observability and incident response, so production behaviour is known rather than guessed.',
    items: [
      'Jest',
      'Cypress',
      'Grafana',
      'Prometheus',
      'Datadog',
      'PostHog',
      'Incident response',
    ],
  },
  {
    title: 'Technical leadership',
    summary: 'The half of the job that is not code — and the half that compounds.',
    items: [
      'Hiring',
      'Mentoring',
      'Performance reviews',
      'OKRs',
      'Stakeholder management',
      'Agile / Scrum',
    ],
  },
];
---

<section class="border-y border-border-subtle bg-surface-raised">
  <Container size="wide" class="py-16 sm:py-24">
    <SectionHeading
      id="capabilities"
      eyebrow="Capabilities"
      title="What I bring to the table"
      description="Deep full-stack range, with AWS, AI tooling and delivery practice underneath it — and the leadership habits that make the rest of a team faster."
    />

    <div class="mt-10 grid gap-5 sm:grid-cols-2">
      {
        groups.map((group) => (
          <Card variant="default" padding="lg" as="article" class="h-full">
            <h3 class="flex items-start gap-3 text-xl font-bold text-ink">
              <span
                aria-hidden="true"
                class="signal-rule mt-1.5 h-5 w-[4px] shrink-0 rounded-full"
                data-orientation="vertical"
              />
              <span class="min-w-0">{group.title}</span>
            </h3>
            <p class="mt-3 text-pretty text-ink-muted">{group.summary}</p>
            <ul class="mt-5 flex flex-wrap gap-2">
              {group.items.map((item) => (
                <li>
                  <Badge variant="outline" size="md">
                    {item}
                  </Badge>
                </li>
              ))}
            </ul>
          </Card>
        ))
      }
    </div>
  </Container>
</section>
