---
/**
 * Role / organisation / period for a case study, as a definition list so the
 * relationship between label and value survives being read out of order.
 */
interface Props {
  role: string;
  org: string;
  period: string;
  class?: string;
}

const { role, org, period, class: className } = Astro.props;

const items: Array<{ term: string; value: string }> = [
  { term: 'Role', value: role },
  { term: 'Organisation', value: org },
  { term: 'Period', value: period },
];
---

<dl
  class:list={[
    'grid gap-x-8 gap-y-4 border-y border-border-subtle py-5 sm:grid-cols-3',
    className,
  ]}
>
  {
    items.map((item) => (
      <div>
        <dt class="text-2xs font-bold tracking-[0.16em] text-ink-subtle uppercase">{item.term}</dt>
        <dd class="mt-1.5 font-semibold text-pretty text-ink">{item.value}</dd>
      </div>
    ))
  }
</dl>
