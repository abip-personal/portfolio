---
/**
 * Sticky site header: wordmark, theme toggle, and a single hamburger menu at
 * every viewport width.
 *
 * The hamburger is the ONE nav affordance, desktop and mobile alike. It is a
 * native <details>/<summary> disclosure, so the menu costs zero client
 * JavaScript by default and is keyboard-operable for free; a tiny inline
 * script only mirrors Enter activation (Chrome ignores it) and closes the
 * panel on link activation or Escape. There is no
 * focus trap or scroll lock — this is a dropdown, not a full-screen overlay.
 *
 * `/blog/` is filtered out while no published post exists, so the nav never
 * points at an empty room.
 */
import { getCollection } from 'astro:content';
import Container from '@/components/ui/Container.astro';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import StyleSwitcher from '@/components/ui/StyleSwitcher.astro';
import { NAV, SITE } from '@/data/site';

const posts = await getCollection('posts', ({ data }) => !data.draft);
const nav = NAV.filter((item) => item.href !== '/blog/' || posts.length > 0);

const { pathname, hash } = Astro.url;

/**
 * Route-aware active state: real routes match by pathname prefix, while the
 * home-page section links only activate on the home page when the matching
 * hash anchor is present.
 */
function isActive(href: string): boolean {
  if (href.startsWith('/#')) {
    const [path, anchor] = href.slice(1).split('#');
    return pathname === (path || '/') && hash === `#${anchor}`;
  }
  const base = href.replace(/\/$/, '');
  return pathname === base || pathname.startsWith(`${base}/`);
}
---

<header
  class="sticky top-0 z-50 border-b border-border-subtle bg-surface/85 backdrop-blur-md supports-[backdrop-filter]:bg-surface/70"
>
  <Container size="wide" class="flex h-16 items-center justify-between gap-4">
    <a
      href="/"
      class="group inline-flex shrink-0 items-center gap-2.5 rounded-sm text-base font-extrabold tracking-[-0.02em] text-ink no-underline sm:text-lg"
    >
      <span
        aria-hidden="true"
        class="signal-rule h-6 w-[5px] shrink-0 rounded-full"
        data-orientation="vertical"></span>
      <span>{SITE.name}</span>
    </a>

    <div class="flex items-center gap-2">
      <StyleSwitcher />
      <ThemeToggle />

      <!-- Primary nav disclosure: the single nav affordance at every width -->
      <details class="site-nav relative">
        <summary
          class="inline-flex size-10 cursor-pointer list-none items-center justify-center rounded-lg border border-border-subtle bg-surface text-ink-muted transition-colors duration-fast hover:border-border hover:bg-accent-soft hover:text-accent [&::-webkit-details-marker]:hidden"
        >
          <span class="sr-only">Menu</span>
          <svg
            class="site-nav__open size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M3 6h18M3 12h18M3 18h18"></path>
          </svg>
          <svg
            class="site-nav__close size-5"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M5 5l14 14M19 5L5 19"></path>
          </svg>
        </summary>
        <!-- Panel is the primary nav at all widths: give it room on desktop,
             and links keep ≥44px touch targets down to 320px. -->
        <nav
          aria-label="Primary"
          class="absolute right-0 z-50 mt-2 w-[min(15rem,calc(100vw-2rem))] rounded-xl border border-border-subtle bg-surface p-2 shadow-lift sm:w-[min(18rem,calc(100vw-3rem))] md:w-72"
        >
          <ul class="flex flex-col gap-1">
            {
              nav.map((item) => (
                <li>
                  <a
                    href={item.href}
                    aria-current={isActive(item.href) ? 'page' : undefined}
                    class:list={[
                      'block min-h-11 rounded-lg px-3.5 py-2.5 text-base font-semibold no-underline transition-colors duration-fast',
                      isActive(item.href)
                        ? 'bg-accent-soft text-accent'
                        : 'text-ink hover:bg-accent-soft hover:text-accent',
                    ]}
                  >
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </details>
    </div>
  </Container>
</header>

<style>
  .site-nav__close {
    display: none;
  }

  .site-nav[open] .site-nav__open {
    display: none;
  }

  .site-nav[open] .site-nav__close {
    display: block;
  }
</style>

<script is:inline>
  // Close the nav disclosure once a link inside it is followed, and on Esc.
  // Enter activation of <summary> is also inconsistent across browsers
  // (Chrome ignores it), so mirror it here — Space already works natively.
  (() => {
    const nav = document.querySelector('details.site-nav');
    if (!nav) return;
    nav.addEventListener('click', (event) => {
      if (event.target instanceof Element && event.target.closest('nav a')) nav.open = false;
    });
    nav.querySelector('summary')?.addEventListener('keydown', (event) => {
      if (event.key === 'Enter') {
        event.preventDefault();
        nav.open = !nav.open;
      }
    });
    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && nav.open) {
        nav.open = false;
        nav.querySelector('summary')?.focus();
      }
    });
  })();
</script>
