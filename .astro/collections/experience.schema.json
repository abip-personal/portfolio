{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "org": {
      "type": "string"
    },
    "period": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "startDate": {
      "type": "string"
    },
    "summary": {
      "type": "string"
    },
    "highlights": {
      "default": [],
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stack": {
